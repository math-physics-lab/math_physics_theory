---
// The page shell: header with search, module navigation and footer, styled after
// https://mr-leshiy-blog.web.app.
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/docs.css';
import ModuleTree from '../components/ModuleTree.astro';
import Search from '../components/Search.astro';
import { library, modulePath, REPO_URL, url } from '../lib/docs';

interface Props {
	title: string;
	description: string;
	/** The module the page documents, highlighted in the navigation. */
	module?: string;
	/** Whether to show the module navigation. */
	sidebar?: boolean;
}

const { title, description, module, sidebar = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<header class="site-header">
			<nav>
				<a href={url('')} class="site-title">{library}</a>
				<div class="internal-links">
					<a href={url('')} class:list={{ active: !module }} aria-current={!module ? 'page' : undefined}>Home</a>
					<a href={url(modulePath(library))} class:list={{ active: !!module }}>Modules</a>
				</div>
				<Search />
				<div class="header-links">
					<a href={REPO_URL} class="icon-link">
						<span class="sr-only">Source on GitHub</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
					</a>
				</div>
			</nav>
		</header>
		<div class:list={['layout', { 'no-sidebar': !sidebar }]}>
			{
				sidebar && (
					<>
						<aside class="sidebar">
							<details open>
								<summary>Modules</summary>
								<nav aria-label="Modules">
									<ModuleTree current={module} />
								</nav>
							</details>
						</aside>
						<script is:inline>
							// On narrow screens the module list sits above the content, so start it collapsed.
							if (matchMedia('(max-width: 960px)').matches) document.querySelector('.sidebar details').open = false;
						</script>
					</>
				)
			}
			<main>
				<slot />
			</main>
		</div>
		<footer class="site-footer">
			<span>
				API docs for <a href={REPO_URL}>{library}</a>, generated with{' '}
				<a href="https://github.com/leanprover/doc-gen4">doc-gen4</a>.
			</span>
		</footer>
	</body>
</html>
