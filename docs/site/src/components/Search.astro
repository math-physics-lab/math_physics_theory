---
// Search over declaration and module names. The index is fetched the first time the box is used.
import { url } from '../lib/docs';
---

<div class="search" data-index={url('search.json')} data-base={url('')}>
	<label class="sr-only" for="search-input">Search declarations</label>
	<input id="search-input" type="search" placeholder="Search…" autocomplete="off" spellcheck="false" />
	<ul class="search-results" role="listbox" hidden></ul>
</div>

<script>
	interface Entry {
		name: string;
		kind: string;
		module: string;
		path: string;
	}

	const root = document.querySelector<HTMLElement>('.search')!;
	const input = root.querySelector('input')!;
	const results = root.querySelector('ul')!;
	let index: Promise<Entry[]> | undefined;
	let selected = 0;

	/** Lower is better: exact match of the last name component, then prefix, then substring. */
	function score(entry: Entry, query: string): number {
		const name = entry.name.toLowerCase();
		const last = name.split('.').pop()!;
		if (last === query || name === query) return 0;
		if (last.startsWith(query)) return 1;
		if (name.includes(query)) return 2 + name.indexOf(query) / 1000;
		// All words of the query, in any order.
		const words = query.split(/\s+/);
		return words.every((w) => name.includes(w)) ? 3 : Infinity;
	}

	function select(i: number) {
		const items = results.querySelectorAll('li');
		if (items.length === 0) return;
		selected = (i + items.length) % items.length;
		items.forEach((li, j) => li.setAttribute('aria-selected', String(j === selected)));
		items[selected].scrollIntoView({ block: 'nearest' });
	}

	async function update() {
		const query = input.value.trim().toLowerCase();
		results.replaceChildren();
		results.hidden = query === '';
		if (query === '') return;
		index ??= fetch(root.dataset.index!).then((r) => r.json());
		const matches = (await index)
			.map((entry) => ({ entry, score: score(entry, query) }))
			.filter((m) => m.score < Infinity)
			.sort((a, b) => a.score - b.score || a.entry.name.length - b.entry.name.length)
			.slice(0, 20);
		if (input.value.trim().toLowerCase() !== query) return;
		for (const { entry } of matches) {
			const li = document.createElement('li');
			li.setAttribute('role', 'option');
			const a = document.createElement('a');
			a.href = root.dataset.base + entry.path;
			const name = document.createElement('span');
			name.className = 'result-name';
			name.textContent = entry.name;
			const meta = document.createElement('span');
			meta.className = 'result-meta';
			meta.textContent = entry.kind === 'module' ? 'module' : `${entry.kind} · ${entry.module}`;
			a.append(name, meta);
			li.append(a);
			results.append(li);
		}
		if (matches.length === 0) {
			const li = document.createElement('li');
			li.className = 'no-results';
			li.textContent = 'No matches';
			results.append(li);
		} else {
			select(0);
		}
	}

	input.addEventListener('input', update);
	input.addEventListener('focus', update);
	input.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
			e.preventDefault();
			select(selected + (e.key === 'ArrowDown' ? 1 : -1));
		} else if (e.key === 'Enter') {
			results.querySelectorAll('a')[selected]?.click();
		} else if (e.key === 'Escape') {
			input.blur();
			results.hidden = true;
		}
	});
	document.addEventListener('click', (e) => {
		if (!root.contains(e.target as Node)) results.hidden = true;
	});
	// `/` focuses the search box, as on doc-gen4's site.
	document.addEventListener('keydown', (e) => {
		if (e.key === '/' && document.activeElement !== input) {
			e.preventDefault();
			input.focus();
		}
	});
</script>
